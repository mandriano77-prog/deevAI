# deevAI web — example env. Copy to .env.local and edit.
# ──────────────────────────────────────────────────────────────────────

# Base URL of the API (the /api/v1/* path is rewritten to ${DEEVAI_API_BASE_URL}/v1/*).
# Defaults to http://localhost:8000 if unset.
DEEVAI_API_BASE_URL=http://localhost:8000
