# deevAI API — example env. Copy to .env and edit.
# ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=deevAI
APP_BASE_URL=http://localhost:3000

API_HOST=0.0.0.0
API_PORT=8000
# 32+ chars, used for JWT signing & state tokens
API_SECRET_KEY=change-me-to-a-32-char-or-longer-random-string

# Async driver auto-applied if value starts with `postgresql://`
DATABASE_URL=postgresql://deevai:deevai-dev@localhost:5432/deevai

# DV360 OAuth user-consent callback — must match the Authorized
# redirect URI registered in each tenant's Google Cloud OAuth client.
#   dev  : http://localhost:3000/onboarding
#   prod : https://deevai.app/onboarding
DV360_REDIRECT_URI=http://localhost:3000/onboarding

# Set to false ONLY after end-to-end live tests pass.
DSP_DRY_RUN=true

# LLM (optional — deevAI works without)
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=

# Email
# RESEND_API_KEY=

# AWS / KMS (optional, falls back to local Fernet vault when unset)
AWS_REGION=eu-central-1
# KMS_KEY_ID=

LOG_LEVEL=INFO
# SENTRY_DSN=
